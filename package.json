{
  "name": "kotoba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "db:up:local": "node scripts/neon-local.mjs start",
    "db:down:local": "node scripts/neon-local.mjs stop",
    "db:status:local": "node scripts/neon-local.mjs status",
    "db:migrate:local": "node scripts/neon-local.mjs migrate",
    "db:reset:local": "node scripts/neon-local.mjs reset",
    "db:history": "node --env-file=.env scripts/neon-db.mjs history",
    "db:inspect": "node --env-file=.env scripts/neon-db.mjs inspect",
    "db:verify": "node --env-file=.env scripts/neon-db.mjs verify",
    "db:prepare:runtime": "node --env-file=.env scripts/neon-db.mjs prepare-runtime",
    "db:migrate:backup": "node --env-file=.env scripts/migrate-supabase-backup.mjs",
    "db:migrate:dry-run": "node --env-file=.env scripts/neon-db.mjs dry-run",
    "db:migrate": "node --env-file=.env scripts/neon-db.mjs migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:local": "node scripts/test-local-integration.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/test-local-e2e.mjs",
    "env:check": "node --env-file=.env scripts/check-deploy-env.mjs",
    "vercel:env": "node --env-file=.env scripts/sync-vercel-env.mjs",
    "deploy:prod": "pnpm run db:prepare:runtime && pnpm run env:check && pnpm run db:migrate:dry-run && pnpm run db:migrate && pnpm run vercel:env && pnpm exec vercel --prod --yes"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@phosphor-icons/react": "^2.1.10",
    "csv-parse": "7.0.3",
    "exceljs": "^4.4.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "58.4.4",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "pnpm": "11.25.0"
  }
}
