# `pnpm run vercel:env` syncs every entry below except names beginning with `LOCAL_`.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Local-only values consumed by `pnpm run dev:local`.
LOCAL_SITE_URL=http://localhost:3000
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key
