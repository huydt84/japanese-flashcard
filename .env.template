# Public values and the restricted application connection are synced to Vercel.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app # @vercel
DATABASE_URL=postgresql://kotoba_runtime:your_runtime_password@your-neon-host.neon.tech/neondb?sslmode=verify-full # @vercel
AUTH_SECRET=your_authjs_secret # @vercel
AUTH_GOOGLE_ID=your_google_oauth_client_id # @vercel
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret # @vercel

# Migration-owner settings stay local and are never uploaded to Vercel.
NEON_PROJECT_ID=your_neon_project_id # @neon-cli
# Optional when the owner URL is stored under DATABASE_URL in .env.
NEON_MIGRATION_URL=postgresql://neondb_owner:your_owner_password@your-neon-host.neon.tech/neondb?sslmode=verify-full

# Local PostgreSQL and browser tests are managed by scripts/neon-local.mjs.
