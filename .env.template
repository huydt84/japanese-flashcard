# Lines marked `@vercel` are the only values synced by `pnpm run vercel:env`.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.vercel.app # @vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co # @vercel
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key # @vercel

# Deployment-only credentials. They are read from `.env` by the Supabase CLI
# wrapper and must never be uploaded to Vercel.
SUPABASE_PROJECT_REF=your_project_ref # @supabase-cli
SUPABASE_ACCESS_TOKEN=your_personal_access_token # @supabase-cli
# Optional fallback when passwordless CLI access is unavailable.
SUPABASE_DB_PASSWORD=

# Local-only values consumed by `pnpm run dev:local`.
LOCAL_SITE_URL=http://localhost:3000
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key
